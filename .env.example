# Free LLM API keys for the live AI spot check (`--live-check`).
# Copy to .env and fill in any you have - every key you add joins the pool,
# so the free tiers stack. LLM7.io, OVHcloud and Kilo Code work with NO key.
# Provider list: https://github.com/mnfst/awesome-free-llm-apis

# Optional for keyless providers (a key raises their limits)
LLM7_API_KEY=                  # https://token.llm7.io
OVH_AI_ENDPOINTS_ACCESS_TOKEN= # https://www.ovhcloud.com/en/public-cloud/ai-endpoints/catalog/
KILO_API_KEY=                  # https://app.kilo.ai/profile

# Free key required
GROQ_API_KEY=                  # https://console.groq.com/keys           30 RPM, 1,000 RPD
GEMINI_API_KEY=                # https://aistudio.google.com/app/apikey
MISTRAL_API_KEY=               # https://console.mistral.ai/api-keys     $10/month credits
OPENROUTER_API_KEY=            # https://openrouter.ai/keys              50 RPD on :free models
NVIDIA_API_KEY=                # https://build.nvidia.com/explore/discover
CLOUDFLARE_API_TOKEN=          # https://dash.cloudflare.com/profile/api-tokens  10k Neurons/day
CLOUDFLARE_ACCOUNT_ID=
OLLAMA_API_KEY=                # https://ollama.com/settings/keys
COHERE_API_KEY=                # https://dashboard.cohere.com/api-keys   1,000 calls/month, non-commercial
ZAI_API_KEY=                   # https://open.bigmodel.cn/usercenter/apikeys
HF_TOKEN=                      # https://huggingface.co/settings/tokens
MODELSCOPE_API_KEY=            # https://modelscope.cn/my/myaccesstoken
SILICONFLOW_API_KEY=           # https://cloud.siliconflow.cn/account/ak
AION_API_KEY=                  # https://www.aionlabs.ai/app/api-keys/

# Optional: only use these providers (comma-separated ids)
# GEO_LLM_PROVIDERS=llm7,groq,gemini
# Optional: override a provider's model
# GEO_LLM_GROQ_MODEL=qwen/qwen3.6-27b
